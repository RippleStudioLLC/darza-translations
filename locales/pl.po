#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "Come, Kacia."
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "Systematically."
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "Weather this, now."
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "Destroy them."
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "Obliterate such delinquency."
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "Pulverize these rodents."
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "They can't be far..."
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "This area's clear..."
