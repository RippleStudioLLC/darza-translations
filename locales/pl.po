#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/MemoryOfFleshBehaviors.cs
msgid "I would have remembered you..."
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/MemoryOfHoneyBehaviors.cs
msgid "May we both now rest.."
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/MemoryOfHoneyBehaviors.cs
msgid "I'll never forget you.."
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/SacrificialSanctuaryBehaviors.cs
#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/SacrificialSanctuaryRoomBehaviors.cs
