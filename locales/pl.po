#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "None shall withstand true might!"
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "Be crushed beneath true might!"
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "Flee from true might!"
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "None shall withstand true fury!"
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "Be crushed beneath true fury!"
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "Flee from true fury!"
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "Your death throes will sing of my honor!"
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "Scream in the choruses of my triumph!"
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "Die where you crawl!"
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "Together!"
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "Do not falter!"
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "As one!"
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "Raze their defenses!"
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "Crush them!"
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "Annihilate their ranks!"
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
msgid "Scatter, you disgraceful weaklings!"
msgstr ""

#: DarzasDominion/DarzaGameServer/Logic/Data/Experienced/HallTwinstarBehaviors.cs
